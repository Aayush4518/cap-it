# Set this to the public origin before building for deployment.
# The build uses it to generate canonical URLs and sitemap.xml.
VITE_SITE_URL=https://your-domain.example

# Leave blank for local development (Vite proxies /api/api1 and /api/api2).
# Set both to the public base URLs of the two Render API services on Vercel.
VITE_API1_URL=
VITE_API2_URL=
