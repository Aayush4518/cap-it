# Local Docker Compose configuration. Copy to .env and replace the placeholder.
NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CAPIT_API_KEY=replace-with-a-local-only-secret
REDIS_URL=redis://localhost:6379
INSTANCE_ID=api1
PROMETHEUS_URL=http://localhost:9090

# Set a separate random value in Render; local Compose leaves /metrics unauthenticated.
METRICS_BEARER_TOKEN=
